# Runs the bot under systemd, without Docker. Expects it built in
# /opt/tactics-bot and a system user tacticsbot; README.md, "Option B",
# has the steps.
#
# Logs: journalctl -u tactics-bot -f

[Unit]
Description=Discord bot for the WoWs Tactics Suite
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tacticsbot
WorkingDirectory=/opt/tactics-bot
ExecStart=/usr/bin/node --env-file=/opt/tactics-bot/.env /opt/tactics-bot/dist/bot.js
Restart=always
RestartSec=5

# The bot needs nothing outside its own data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tactics-bot/data

[Install]
WantedBy=multi-user.target
