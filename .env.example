# Copy to .env and fill in. .env is gitignored and must never be committed.
# Create the application at https://discord.com/developers/applications

# Bot token, from the application's Bot tab. Reset it there if it has ever
# been pasted anywhere it should not have been.
DISCORD_TOKEN=

# Application ID, from the General Information tab.
DISCORD_APP_ID=

# Client secret, from the OAuth2 tab. The suite's Connect Discord sign-in
# needs it.
DISCORD_CLIENT_SECRET=

# Where the bot is reached from outside, with no path. Must be https.
# Add <PUBLIC_URL>/link/callback as a redirect on the OAuth2 tab, and enter
# PUBLIC_URL as the bot address in the suite's Settings.
PUBLIC_URL=https://bot.example.com

# Docker Compose only: the hostname Caddy gets a certificate for. The same
# host as PUBLIC_URL.
BOT_DOMAIN=bot.example.com

# Optional, for /release: the suite's update server, where the patch notes
# are published. Leave both empty and /release says it is not set up.
UPDATE_URL=
UPDATE_TOKEN=

# Without Docker only; the container sets its own.
DB_PATH=./data/bot.db
HTTP_HOST=127.0.0.1
HTTP_PORT=8787

# error | warn | info | debug
LOG_LEVEL=info
